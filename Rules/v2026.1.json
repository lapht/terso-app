{
  "version": "2026.1",
  "schemaVersion": 1,
  "rules": [
    {
      "id": "caches.user.safari",
      "module": "caches.user",
      "category": "Caches",
      "name": "Safari cache",
      "description": "Finds recreatable cache files in Safari's user cache directory.",
      "allowlistRoots": [
        "~/Library/Caches/com.apple.Safari"
      ],
      "paths": [],
      "patterns": [
        "**/*"
      ],
      "exclusions": [],
      "isTrashSafe": true
    },
    {
      "id": "caches.user.chrome",
      "module": "caches.user",
      "category": "Caches",
      "name": "Google Chrome cache",
      "description": "Finds recreatable cache files in Chrome's user cache directory.",
      "allowlistRoots": [
        "~/Library/Caches/com.google.Chrome"
      ],
      "paths": [],
      "patterns": [
        "**/*"
      ],
      "exclusions": [],
      "isTrashSafe": true
    },
    {
      "id": "caches.user.firefox",
      "module": "caches.user",
      "category": "Caches",
      "name": "Firefox cache",
      "description": "Finds recreatable cache files in Firefox's user cache directory.",
      "allowlistRoots": [
        "~/Library/Caches/org.mozilla.firefox"
      ],
      "paths": [],
      "patterns": [
        "**/*"
      ],
      "exclusions": [],
      "isTrashSafe": true
    },
    {
      "id": "caches.user.vscode",
      "module": "caches.user",
      "category": "Caches",
      "name": "Visual Studio Code cache",
      "description": "Finds recreatable cache files in Visual Studio Code's user cache directory.",
      "allowlistRoots": [
        "~/Library/Caches/com.microsoft.VSCode"
      ],
      "paths": [],
      "patterns": [
        "**/*"
      ],
      "exclusions": [],
      "isTrashSafe": true
    },
    {
      "id": "logs.user.rotated",
      "module": "logs.user",
      "category": "Logs",
      "name": "Old user logs",
      "description": "Finds old user logs, compressed logs, crash reports, and numbered log rotations; keeps Terso audit logs.",
      "allowlistRoots": [
        "~/Library/Logs"
      ],
      "paths": [],
      "patterns": [
        "**/*.log",
        "**/*.gz",
        "**/*.crash",
        "**/*.log.[0-9]*"
      ],
      "exclusions": [
        "Terso/**"
      ],
      "minAgeSeconds": 86400,
      "isTrashSafe": true
    },
    {
      "id": "xcode.derived-data",
      "module": "xcode.junk",
      "category": "Xcode",
      "name": "Xcode DerivedData",
      "description": "Finds rebuildable Xcode build data under DerivedData.",
      "allowlistRoots": [
        "~/Library/Developer/Xcode/DerivedData"
      ],
      "paths": [],
      "patterns": [
        "**/*"
      ],
      "exclusions": [],
      "isTrashSafe": true
    },
    {
      "id": "xcode.old-archives",
      "module": "xcode.junk",
      "category": "Xcode",
      "name": "Old Xcode archives",
      "description": "Finds Xcode archives older than 90 days for review before trashing.",
      "allowlistRoots": [
        "~/Library/Developer/Xcode/Archives"
      ],
      "paths": [],
      "patterns": [
        "**/*.xcarchive"
      ],
      "exclusions": [],
      "minAgeSeconds": 7776000,
      "isTrashSafe": true
    },
    {
      "id": "xcode.simulator-caches",
      "module": "xcode.junk",
      "category": "Xcode",
      "name": "Simulator caches",
      "description": "Finds recreatable CoreSimulator cache files.",
      "allowlistRoots": [
        "~/Library/Developer/CoreSimulator/Caches"
      ],
      "paths": [],
      "patterns": [
        "**/*"
      ],
      "exclusions": [],
      "isTrashSafe": true
    },
    {
      "id": "packages.homebrew",
      "module": "packages",
      "category": "Package caches",
      "name": "Homebrew cache",
      "description": "Finds downloaded package files in Homebrew's user cache.",
      "allowlistRoots": [
        "~/Library/Caches/Homebrew"
      ],
      "paths": [],
      "patterns": [
        "**/*"
      ],
      "exclusions": [],
      "isTrashSafe": true
    },
    {
      "id": "packages.npm",
      "module": "packages",
      "category": "Package caches",
      "name": "npm content cache",
      "description": "Finds npm content-cache files without including npm configuration.",
      "allowlistRoots": [
        "~/.npm/_cacache"
      ],
      "paths": [],
      "patterns": [
        "**/*"
      ],
      "exclusions": [],
      "isTrashSafe": true
    },
    {
      "id": "packages.yarn-library",
      "module": "packages",
      "category": "Package caches",
      "name": "Yarn cache",
      "description": "Finds downloaded packages in Yarn's Library cache.",
      "allowlistRoots": [
        "~/Library/Caches/Yarn"
      ],
      "paths": [],
      "patterns": [
        "**/*"
      ],
      "exclusions": [],
      "isTrashSafe": true
    },
    {
      "id": "packages.yarn-user",
      "module": "packages",
      "category": "Package caches",
      "name": "Yarn user cache",
      "description": "Finds downloaded packages in Yarn's user cache.",
      "allowlistRoots": [
        "~/.cache/yarn"
      ],
      "paths": [],
      "patterns": [
        "**/*"
      ],
      "exclusions": [],
      "isTrashSafe": true
    },
    {
      "id": "packages.pnpm",
      "module": "packages",
      "category": "Package caches",
      "name": "pnpm cache",
      "description": "Finds pnpm cache files under its user cache directory.",
      "allowlistRoots": [
        "~/Library/Caches/pnpm"
      ],
      "paths": [],
      "patterns": [
        "**/*"
      ],
      "exclusions": [],
      "isTrashSafe": true
    }
  ]
}
