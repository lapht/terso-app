{
  "version": "2026.2",
  "schemaVersion": 2,
  "rules": [
    {
      "id": "caches.user.basic",
      "module": "caches.user",
      "category": "Caches",
      "name": "User cache files",
      "description": "A rule without app patterns, ignored by leftover detection.",
      "allowlistRoots": [
        "~/Library/Caches"
      ],
      "paths": [],
      "patterns": [
        "**/*"
      ],
      "exclusions": [],
      "isTrashSafe": true
    },
    {
      "id": "leftovers.example.editor",
      "module": "leftovers",
      "category": "Leftovers",
      "name": "Example Editor leftovers",
      "description": "Support files left behind by Example Editor.",
      "allowlistRoots": [
        "~/Library/Application Support",
        "~/Library/Caches",
        "~/Library/Preferences"
      ],
      "paths": [],
      "patterns": [],
      "exclusions": [],
      "isTrashSafe": true,
      "appPatterns": [
        {
          "bundleID": "com.example.Editor",
          "paths": [
            "~/Library/Application Support/Example Editor",
            "~/Library/Application Support/Example Common",
            "~/Library/Caches/{bundleID}",
            "~/Library/Preferences/{bundleID}.plist"
          ]
        }
      ],
      "provenance": {
        "source": "https://example.com/editor/uninstall",
        "author": "terso-maintainer",
        "date": "2026-10-16",
        "rationale": "Vendor documentation lists these locations as created by the app."
      }
    },
    {
      "id": "leftovers.example.viewer",
      "module": "leftovers",
      "category": "Leftovers",
      "name": "Example Viewer leftovers",
      "description": "Support files of Example Viewer, which shares a folder with Example Editor.",
      "allowlistRoots": [
        "~/Library/Application Support",
        "~/Library/Caches",
        "~/Library/Preferences"
      ],
      "paths": [],
      "patterns": [],
      "exclusions": [],
      "isTrashSafe": true,
      "appPatterns": [
        {
          "bundleID": "com.example.Viewer",
          "paths": [
            "~/Library/Application Support/Example Common",
            "~/Library/Caches/{bundleID}",
            "~/Library/Preferences/{bundleID}.plist"
          ]
        }
      ],
      "provenance": {
        "source": "Observed install of Example Viewer 1.0",
        "author": "terso-maintainer",
        "date": "2026-10-16",
        "rationale": "The app creates these locations on first launch."
      }
    },
    {
      "id": "leftovers.example.suite",
      "module": "leftovers",
      "category": "Leftovers",
      "name": "Example Suite leftovers",
      "description": "Sandbox container of Example Writer and the group container of Example Suite.",
      "allowlistRoots": [
        "~/Library/Containers",
        "~/Library/Group Containers"
      ],
      "paths": [],
      "patterns": [],
      "exclusions": [],
      "isTrashSafe": true,
      "appPatterns": [
        {
          "bundleID": "com.example.suite.Writer",
          "paths": [
            "~/Library/Containers/{bundleID}"
          ]
        },
        {
          "bundleID": "com.example.suite.Writer",
          "paths": [
            "~/Library/Group Containers/ABCDE12345.com.example.suite"
          ],
          "shared": true,
          "groupIdentifier": "ABCDE12345.com.example.suite"
        },
        {
          "bundleID": "com.example.suite.Reader",
          "paths": [
            "~/Library/Group Containers/ABCDE12345.com.example.suite"
          ],
          "shared": true,
          "groupIdentifier": "ABCDE12345.com.example.suite"
        }
      ],
      "provenance": {
        "source": "Observed install of Example Suite 3.2",
        "author": "terso-maintainer",
        "date": "2026-02-28",
        "rationale": "The container is created on first launch; the group container is shared by suite apps."
      }
    }
  ]
}
